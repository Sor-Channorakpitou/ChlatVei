# Copy to .env and change every value marked change-me. Never commit .env.

NODE_ENV=development
PORT=3000

# Matches docker-compose.yml defaults (host port 55432)
DATABASE_URL=postgresql://chlatvei:chlatvei_dev@localhost:55432/chlatvei
# Used by e2e tests only
TEST_DATABASE_URL=postgresql://chlatvei:chlatvei_dev@localhost:55432/chlatvei_test

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:4200

# If true, an admin cannot approve content they created themselves
REQUIRE_DIFFERENT_APPROVER=false

# Used once by `npm run create-admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Set to false only in automated tests
RATE_LIMIT_ENABLED=true
