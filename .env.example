# Settings for `docker compose up` (full stack). Copy to .env and change every value. Never commit .env.

# Database
POSTGRES_USER=chlatvei
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=chlatvei

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=

# Shared key between backend and ML service (any long random string)
ML_API_KEY=

# The address citizens use (for CORS); and the port nginx listens on
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# true once there are at least two admins
REQUIRE_DIFFERENT_APPROVER=false
